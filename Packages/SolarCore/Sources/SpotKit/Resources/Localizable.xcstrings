    "exposure.fullSun.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomatoes, peppers, lavender, most vegetables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomaten, Paprika, Lavendel, die meisten Gemüsesorten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomates, poivrons, lavande, la plupart des légumes."
          }
        }
      }
    },
    "exposure.partSun.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enough for beans, carrots and most herbs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reicht für Bohnen, Karotten und die meisten Kräuter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suffisant pour les haricots, les carottes et la plupart des herbes."
          }
        }
      }
    },
    "exposure.partShade.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leafy greens and shade-tolerant shrubs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blattgemüse und schattenverträgliche Sträucher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Légumes-feuilles et arbustes tolérant l’ombre."
          }
        }
      }
    },
    "exposure.fullShade.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferns and hostas. Fruit will not ripen here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farne und Funkien. Früchte reifen hier nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fougères et hostas. Aucun fruit ne mûrira ici."
          }
        }
      }
    }
