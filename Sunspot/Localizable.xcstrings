    },
    "Add another spot and this will put them side by side.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add another spot and this will put them side by side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine zweite Stelle hinzu, dann stehen sie hier nebeneinander."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un second emplacement et ils seront comparés côte à côte."
          }
        }
      }
    },
