    "Bolts in a hot, wide-open spot. Afternoon shade suits it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolts in a hot, wide-open spot. Afternoon shade suits it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schießt an einem heißen, offenen Platz. Nachmittagsschatten tut ihm gut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte en graine dans un endroit chaud et dégagé. L’ombre de l’après-midi lui convient."
          }
        }
      }
    },
