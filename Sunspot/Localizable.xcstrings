        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne ist nur einer von mehreren Faktoren. Boden, Wasser und Wind entscheiden ebenso viel — und davon weiß diese App nichts."
          }
        },
        "fr": {
